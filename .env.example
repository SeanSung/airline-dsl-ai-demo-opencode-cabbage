# ===== 必填 =====
# DeepSeek API Key（后端启动缺失会直接报错）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# ===== 可选（下面是默认值）=====

# 下游 GBH 航线提交服务地址
GBH_BASE_URL=http://192.168.8.151:5175

# 天地图底图 token（留空则 Cesium 地图无瓦片）
TIANDITU_TOKEN=your-tianditu-token

# LLM 工具降级开关
LLM_FALLBACK_ENABLED=true
# 天地图底图 token（浏览器端公开 token，留空则 Cesium 地图无瓦片）
TIANDITU_TOKEN=643e236518d4875f1d2d9232af78f835
WEB_PORT=80
